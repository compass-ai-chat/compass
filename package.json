{
  "name": "compass",
  "main": "index.ts",
  "version": "1.0.2",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "build:web": "npx expo export --platform web",
    "serve:web": "npx serve dist -p 3059",
    "dev:tauri-fast": "npm run build:web && npm run serve:web",
    "build:linux": "NO_STRIP=true WEBKIT_DISABLE_DMABUF_RENDERER=1 WEBKIT_DISABLE_COMPOSITING_MODE=1 npx tauri build",
    "build:android": "eas build -p android --profile preview",
    "build:android-local": "eas build -p android --profile preview --local",
    "build:windows": "npx tauri build --target x86_64-pc-windows-msvc",
    "dev-tauri": "npx tauri dev",
    "ios": "expo start --ios",
    "web": "npx expo start --port 3059",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "deploy": "gh-pages --nojekyll -d dist",
    "predeploy": "expo export -p web",
    "windows": "npx @react-native-community/cli run-windows"
  },
  "jest": {
    "preset": "jest-expo"
  },
